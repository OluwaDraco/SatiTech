generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

generator pothos {
  provider = "prisma-pothos-types"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clients {
  id             String   @id
  company_name   String?
  country        String?
  total_spent    Decimal? @db.Decimal
  feedback_score Decimal? @db.Decimal
  jobs           Job[]

  @@map("client")
}

model Job {
  id          String    @id
  title       String?
  description String?
  skills      String[]
  job_type    String?
  budget      Decimal?  @db.Decimal
  duration    String?
  workload    String?
  client_id   String?
  created_at  DateTime? @db.Timestamp(6)
  rate        Decimal?  @db.Money
  user_id     String?
  clients     Clients?  @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       Users?    @relation("UserJobs", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  task        Task[]    @relation("JobTasks")

  @@map("jobs")
}

model Task{
    id String @id
    title String
    priority String
    status String
    due DateTime? @db.Timestamp(6)
    reviewer String
    user_id     String
    job_id      String
    users       Users    @relation("UserTask", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
    job        Job     @relation("JobTasks", fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

}

model sati_users {
  id       String  @id
  email    String?
  password String?
}

model Users {
  id          String   @id(map: "freelancers_pkey") @default(uuid())
  full_name   String?
  title       String?
  rate        Decimal? @db.Decimal
  location    String?
  skills      String[]
  overview    String?
  admin       Boolean? @default(false)
  email       String?  @unique
  profile_url String?
  reviews     String[]
  password    String?
  jobs        Job[]   @relation("UserJobs")
  task Task[] @relation("UserTask")

  @@map("users")
}
