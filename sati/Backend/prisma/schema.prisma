generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clients {
  id             String    @id 
  company_name   String?
  country        String?
  total_spent    Decimal? @db.Decimal
  feedback_score Decimal? @db.Decimal
  jobs           Jobs[]

  @@map("client")
}

model Jobs {
  id          String    @id
  title       String?
  description String?
  skills      String[]
  job_type    String?
  budget      Decimal?  @db.Decimal
  duration    String?
  workload    String?
  user_id     String?
  client_id   String?
  created_at  DateTime? @db.Timestamp(6)
  rate        Decimal?  @db.Money
  clients     Clients?  @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       Users?   @relation("UserJobs", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("jobs")
}

model sati_users {
  id       String  @id
  email    String?
  password String?
}

model test {
  id        String  @id
  full_name String?
}

model Users {
  id          String @default(uuid())
  full_name   String?
  title       String?
  rate        Decimal? @db.Decimal
  location    String?
  skills      String[]
  overview    String?
  admin       Boolean? @default(false)
  email       String? @unique
  profile_url String?
  reviews     String[]
  password    String?
  jobs        Jobs[]   @relation("UserJobs") 

  @@map("users")
  @@id([id], map: "freelancers_pkey")
}
