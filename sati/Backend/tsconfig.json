{
    "compilerOptions": {
        "rootDirs": ["src"],
        "outDir": "dist",
        "lib": ["es2020"],
        "target": "es2020",
        "module": "es2022",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "types": ["node", "jest"],
        "skipLibCheck": true
    },
    "exclude": ["node_modules", "dist", "generated"]
}
