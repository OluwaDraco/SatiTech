{
    "compilerOptions": {
        "rootDirs": ["src"],
        "outDir": "dist",
        "lib": ["es2020"],
        "target": "es2020",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "types": ["node", "jest"],
        "skipLibCheck": true,
        "module": "NodeNext",
        "moduleResolution": "NodeNext"
    },
    "exclude": ["node_modules", "dist", "generated"]
}
